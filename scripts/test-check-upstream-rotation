#!/usr/bin/env python3
"""Focused fixtures for check-upstream-rotation."""

from __future__ import annotations

import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import tempfile
import tomllib
import unittest
from pathlib import Path
from unittest import mock

sys.dont_write_bytecode = True


SCRIPT = Path(__file__).with_name("check-upstream-rotation")
REPO = SCRIPT.parent.parent
ROTATION_BASE = "e1833238e0c502ed744e24d5feaaffde7b858c74"
ROTATION_RESULT = "6bbc932c05eb60a377b5053f78088ce224c02014"
ROTATION_SPEC_PATH = SCRIPT.parent / "upstream-rotations/ens_v2-ccaeb58-a971bd64.toml"
LOADER = importlib.machinery.SourceFileLoader("check_upstream_rotation", str(SCRIPT))
SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
assert SPEC is not None
rotation = importlib.util.module_from_spec(SPEC)
sys.modules[LOADER.name] = rotation
LOADER.exec_module(rotation)


def cite(path: str, lines: str = "L1", tag: str = "a971bd64") -> bytes:
    return (
        f"(upstream: .refs/ens_v2/{path}:{lines} @ ens_v2@{tag})"
    ).encode()


def git_bytes(*args: str) -> bytes:
    return subprocess.run(
        ["git", *args], cwd=REPO, check=True, capture_output=True
    ).stdout


def commit_blob(parent: str, path: str, data: bytes, message: str) -> str:
    """Create an unreferenced fixture commit without moving the worktree."""
    with tempfile.TemporaryDirectory() as temporary:
        environment = os.environ.copy()
        environment["GIT_INDEX_FILE"] = str(Path(temporary) / "index")
        environment["GIT_AUTHOR_NAME"] = "Rotation fixture"
        environment["GIT_AUTHOR_EMAIL"] = "fixture@example.com"
        environment["GIT_COMMITTER_NAME"] = "Rotation fixture"
        environment["GIT_COMMITTER_EMAIL"] = "fixture@example.com"
        subprocess.run(
            ["git", "read-tree", parent], cwd=REPO, env=environment, check=True
        )
        object_id = subprocess.run(
            ["git", "hash-object", "-w", "--stdin"],
            cwd=REPO,
            env=environment,
            input=data,
            check=True,
            capture_output=True,
        ).stdout.decode().strip()
        subprocess.run(
            ["git", "update-index", "--add", "--cacheinfo", "100644", object_id, path],
            cwd=REPO,
            env=environment,
            check=True,
        )
        tree = subprocess.run(
            ["git", "write-tree"],
            cwd=REPO,
            env=environment,
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        return subprocess.run(
            ["git", "commit-tree", tree, "-p", parent, "-m", message],
            cwd=REPO,
            env=environment,
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()


class CitationParserTests(unittest.TestCase):
    def test_multiple_citations_and_ranges_on_one_line(self) -> None:
        data = cite("a.sol") + b" " + cite("b.sol", "L2-L4")
        parsed = rotation.parse_citations(data, loose=False)
        self.assertEqual([(row.start, row.end) for row in parsed], [(1, 1), (2, 4)])
        unusual = b"one\x0bstill-one\ntwo\r\nthree"
        self.assertEqual(
            rotation.byte_lines(unusual),
            [b"one\x0bstill-one", b"two\r", b"three"],
        )
        self.assertEqual(rotation.excerpt(unusual, 1, 1), b"one\x0bstill-one\n")
        self.assertEqual(rotation.excerpt(unusual, 2, 2), b"two\r\n")

    def test_worktree_inventory_includes_untracked_verifier_deliverables(self) -> None:
        self.assertIn(
            "scripts/test-check-upstream-rotation",
            rotation.revision_paths("WORKTREE"),
        )

    def test_malformed_old_tag_is_in_raw_census_but_not_strict_parser(self) -> None:
        old_tag = b"ens_v2@" + b"ccaeb58"
        data = (
            b"(upstream:\n.refs/ens_v2/contracts/src/Foo.sol:L7 @\n"
            + old_tag
            + b")"
        )
        self.assertEqual(data.count(old_tag), 1)
        self.assertEqual(rotation.parse_citations(data, loose=False), [])
        loose = rotation.parse_citations(data, loose=True)
        self.assertEqual(len(loose), 1)
        self.assertFalse(loose[0].strict)

        for malformed_tag in ("A971BD64", "not-a-sha", "", "z" * 65):
            malformed = cite("contracts/src/Foo.sol", tag=malformed_tag)
            self.assertEqual(rotation.parse_citations(malformed, loose=False), [])
            recovered = rotation.parse_citations(malformed, loose=True)
            self.assertEqual(len(recovered), 1)
            self.assertFalse(recovered[0].strict)

        malformed_markers = (
            cite("contracts/src/Foo.sol", tag="a971 bd64"),
            cite("contracts/src/Foo.sol").replace(b"@ ens_v2@", b"@ ens-v2@"),
        )
        for malformed in malformed_markers:
            with mock.patch.object(
                rotation, "manifest_refs", return_value={"ens_v2": {"commit": "x"}}
            ), mock.patch.object(
                rotation, "revision_paths", return_value=["docs/malformed.md"]
            ), mock.patch.object(
                rotation, "worktree_or_blob", return_value=malformed
            ):
                _, errors = rotation.validate_final_citations(
                    "WORKTREE", {"ens_v2"}, []
                )
            self.assertTrue(errors)

    def test_historical_ref_is_canonical(self) -> None:
        data = (
            b"(upstream: .refs/"
            + b"ens_v2_sepolia_20260629/contracts/src/Foo.sol:L9 "
            + b"@ ens_v2_sepolia_20260629@ccaeb58)"
        )
        parsed = rotation.parse_citations(data, loose=False)
        self.assertEqual(parsed[0].key, "ens_v2_sepolia_20260629")


class MappingTests(unittest.TestCase):
    def test_git_hunks_map_insertions_and_deletions(self) -> None:
        self.assertEqual(
            rotation.equal_line_map_from_hunks(5, 5, [(2, 1, 1, 0), (4, 0, 4, 1)]),
            {1: 1, 3: 2, 4: 3, 5: 5},
        )

    def test_git_hunk_insertion_at_start(self) -> None:
        self.assertEqual(
            rotation.equal_line_map_from_hunks(2, 3, [(0, 0, 1, 1)]),
            {1: 2, 2: 3},
        )

    def test_same_line_tag_refresh(self) -> None:
        self.assertEqual(rotation.mapped_range({1: 1, 2: 2}, 2, 2), (2, 2))

    def test_inserted_line_reanchor(self) -> None:
        self.assertEqual(rotation.mapped_range({1: 1, 2: 3}, 2, 2), (3, 3))

    def test_noncontiguous_duplicate_line_mapping_is_rejected(self) -> None:
        self.assertIsNone(rotation.mapped_range({1: 2, 2: 4}, 1, 2))

    def test_deployment_suffix_remap(self) -> None:
        old_prefix = "contracts/deployments/sepolia/"
        archive = "contracts/deployments/sepolia-20260629-r1/"
        old = old_prefix + "nested/RootRegistry.json"
        self.assertEqual(archive + old.removeprefix(old_prefix), archive + "nested/RootRegistry.json")

    def test_full_file_archive_mismatch_is_visible(self) -> None:
        self.assertNotEqual(rotation.sha256(b"old\n"), rotation.sha256(b"changed\n"))

    def test_rewrite_refuses_a_nonbaseline_carrier(self) -> None:
        self.assertEqual(
            rotation.rewrite_input_mismatch("docs/example.md", b"base", b"edited"),
            "docs/example.md",
        )

    def test_claim_context_binds_the_citation_to_nearby_text(self) -> None:
        first = b"first claim " + cite("a.sol") + b"\n\nsecond claim\n"
        moved = b"first claim\n\nsecond claim " + cite("a.sol") + b"\n"
        first_citation = rotation.parse_citations(first, loose=True)[0]
        moved_citation = rotation.parse_citations(moved, loose=True)[0]
        self.assertNotEqual(
            rotation.citation_claim_context(first, first_citation),
            rotation.citation_claim_context(moved, moved_citation),
        )

    def test_claim_normalization_retains_operator_after_comment_marker(self) -> None:
        self.assertNotEqual(
            rotation.normalized_claim_tokens(b"// + duration"),
            rotation.normalized_claim_tokens(b"// - duration"),
        )

    def test_claim_normalization_retains_star_list_indentation(self) -> None:
        self.assertNotEqual(
            rotation.normalized_claim_tokens(b"* claim"),
            rotation.normalized_claim_tokens(b"    * claim"),
        )

    def test_claim_normalization_distinguishes_quote_and_star_list_markers(self) -> None:
        self.assertNotEqual(
            rotation.normalized_claim_tokens(b"> claim"),
            rotation.normalized_claim_tokens(b"* claim"),
        )

    def test_commonmark_raw_html_forms_are_recognized(self) -> None:
        cases = {
            b"<address>": "blank",
            b"<custom data-kind='evidence'>": "blank",
            b"<?audit": "processing",
            b"<!AUDIT": "declaration",
            b"<![CDATA[": "cdata",
        }
        for line, expected in cases.items():
            with self.subTest(line=line):
                self.assertEqual(rotation.commonmark_raw_html_start(line), expected)
        self.assertIsNone(
            rotation.commonmark_raw_html_start(b"<script/>", allow_type7=False)
        )
        self.assertIsNone(rotation.commonmark_raw_html_start(b"</custom attr>"))
        self.assertEqual(rotation.commonmark_raw_html_start(b"</custom>"), "blank")
        self.assertIsNone(rotation.commonmark_raw_html_start(b"<!lowercase"))
        self.assertFalse(rotation.commonmark_raw_html_ends("raw-tag", b"</script >"))
        self.assertIsNone(rotation.markdown_fence_open(b"```invalid`info"))

    def test_claim_binding_rejects_a_same_paragraph_target_swap(self) -> None:
        original = b"[^a]: " + cite("a.sol") + b"\n[^b]: " + cite("b.sol") + b"\n"
        swapped = b"[^a]: " + cite("b.sol") + b"\n[^b]: " + cite("a.sol") + b"\n"
        original_citations = rotation.parse_citations(original, loose=True)
        swapped_citations = rotation.parse_citations(swapped, loose=True)
        original_bindings = rotation.citation_claim_bindings(
            original, original_citations
        )
        swapped_bindings = rotation.citation_claim_bindings(swapped, swapped_citations)
        original_a = next(row for row in original_citations if row.path == "a.sol")
        swapped_a = next(row for row in swapped_citations if row.path == "a.sol")
        self.assertNotEqual(
            original_bindings[original_a.begin], swapped_bindings[swapped_a.begin]
        )
        self.assertIsNone(
            rotation.rewrite_input_mismatch("docs/example.md", b"base", b"base")
        )


class ClaimBindingVerifyTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.spec = rotation.load_spec(ROTATION_SPEC_PATH)
        cls.head = ROTATION_RESULT

    def verify_head(self, head: str) -> str:
        with tempfile.TemporaryDirectory() as temporary, mock.patch.object(
            rotation, "fingerprint_report", return_value="fixture fingerprint\n"
        ), mock.patch.object(rotation, "write_reports"), mock.patch.object(
            rotation, "write_review_reports"
        ):
            return rotation.verify(
                ROTATION_BASE, head, self.spec, Path(temporary)
            )

    def test_verify_rejects_same_paragraph_reattachment(self) -> None:
        path = "docs/architecture.md"
        citation = cite(
            "contracts/src/registry/PermissionedRegistry.sol", "L113"
        )
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        self.assertIn(citation, lines[480])
        lines[480] = lines[480].replace(b" " + citation, b"")
        lines[481] += b" " + citation
        fixture = commit_blob(
            self.head, path, b"\n".join(lines), "fixture: reattach citation"
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_same_line_reattachment(self) -> None:
        path = "docs/architecture.md"
        citation = cite(
            "contracts/src/registry/interfaces/IRegistryEvents.sol", "L9"
        )
        data = git_bytes("show", f"{self.head}:{path}")
        destination = b"The admission does not require a parent link."
        self.assertEqual(data.count(citation), 1)
        self.assertEqual(data.count(destination), 1)
        changed = data.replace(b" " + citation, b"", 1).replace(
            destination, destination + b" " + citation, 1
        )
        fixture = commit_blob(
            self.head, path, changed, "fixture: reattach citation on claim line"
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_same_sentence_clause_reattachment(self) -> None:
        path = "AGENTS.md"
        archive = cite(
            "contracts/deployments/sepolia-20260629-r1/.deployment.json", "L4"
        )
        live = cite("contracts/deployments/sepolia/.deployment.json", "L4")
        data = git_bytes("show", f"{self.head}:{path}")
        self.assertEqual(data.count(archive), 1)
        self.assertEqual(data.count(live), 1)
        changed = data.replace(b" " + archive, b"", 1).replace(
            b" " + live, b" " + archive + b" " + live, 1
        )
        fixture = commit_blob(
            self.head, path, changed, "fixture: reattach citation across clause"
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "undispositioned governed citation"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_operator_only_claim_flip(self) -> None:
        path = "docs/manifests.md"
        data = git_bytes("show", f"{self.head}:{path}")
        before = b"`start_block = 11163391`"
        after = b"`start_block != 11163391`"
        self.assertEqual(data.count(before), 1)
        fixture = commit_blob(
            self.head,
            path,
            data.replace(before, after),
            "fixture: flip claim operator",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_arithmetic_operator_flip(self) -> None:
        path = "docs/manifests.md"
        data = git_bytes("show", f"{self.head}:{path}")
        before = b"block.timestamp + duration"
        after = b"block.timestamp - duration"
        self.assertEqual(data.count(before), 1)
        fixture = commit_blob(
            self.head,
            path,
            data.replace(before, after),
            "fixture: flip arithmetic claim operator",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_leading_dot_removal(self) -> None:
        path = "docs/architecture.md"
        data = git_bytes("show", f"{self.head}:{path}")
        before = b"second-level `.eth` name"
        after = b"second-level `eth` name"
        self.assertEqual(data.count(before), 1)
        fixture = commit_blob(
            self.head,
            path,
            data.replace(before, after),
            "fixture: remove semantic leading dot",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_period_reassignment(self) -> None:
        path = "docs/upstream.md"
        citation = cite(
            "contracts/src/reverse-registrar/StandaloneReverseRegistrar.sol",
            "L176",
        )
        data = git_bytes("show", f"{self.head}:{path}")
        before = citation + b"`. ENSv2 registry renewal"
        after = b". `" + citation + b"` ENSv2 registry renewal"
        self.assertEqual(data.count(before), 1)
        fixture = commit_blob(
            self.head,
            path,
            data.replace(before, after),
            "fixture: move sentence period across citation",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "undispositioned governed citation"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_preexisting_citation_paragraph_relocation(self) -> None:
        path = "docs/manifests.md"
        citation = cite(
            "contracts/src/registry/PermissionedRegistry.sol", "L142-L146"
        )
        data = git_bytes("show", f"{self.head}:{path}")
        self.assertEqual(data.count(citation), 1)
        changed = (
            data.replace(b" " + citation, b"", 1)
            + b"\nregistry "
            + citation
            + b".\n"
        )
        fixture = commit_blob(
            self.head,
            path,
            changed,
            "fixture: relocate pre-existing citation to another paragraph",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "undispositioned governed citation"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_citation_before_declaration_relocation(self) -> None:
        path = "apps/phase-runner/tests/production_interpret.rs"
        citation = cite(
            "contracts/src/registry/interfaces/IRegistryEvents.sol", "L56-L60"
        )
        data = git_bytes("show", f"{self.head}:{path}")
        citation_line = b"            // " + citation + b"\n"
        destination = (
            b'                "normalized_events": ["RegistrationGranted"]\n'
            b"            },\n"
        )
        self.assertEqual(data.count(citation_line), 1)
        self.assertEqual(data.count(destination), 1)
        changed = data.replace(citation_line, b"", 1).replace(
            destination, destination + citation_line, 1
        )
        fixture = commit_blob(
            self.head,
            path,
            changed,
            "fixture: relocate citation before another declaration",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_table_row_section_relocation(self) -> None:
        path = "docs/manifests.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        row_index = next(
            index
            for index, line in enumerate(lines)
            if line.startswith(b"| Unlocked migration controller |")
        )
        row = lines.pop(row_index)
        heading = lines.index(b"### Basenames mainnet")
        lines.insert(heading + 1, row)
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: move ENSv2 table row under Basenames",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_markdown_code_block_reclassification(self) -> None:
        path = "docs/architecture.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        self.assertTrue(lines[480].startswith(b"- `RegistryCreated()`"))
        lines[480] = b"    " + lines[480]
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: reclassify citation claim as Markdown code",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_indented_prose_code_block_reclassification(self) -> None:
        path = "docs/manifests.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        self.assertTrue(lines[309].startswith(b"ENSv2 terminal lifecycle events"))
        lines[309] = b"    " + lines[309]
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: reclassify cited prose as Markdown code",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-line binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_blockquote_to_star_list_reclassification(self) -> None:
        path = "docs/upstream.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        heading = (
            "> **ENSv2 max-expiry projection narrowing** — bigname current "
            "projections expose expiry timestamps as finite Unix-second values "
            "or `null`; they do not fabricate far-future dates for "
            "`type(uint64).max`."
        ).encode()
        start = lines.index(heading)
        for index in range(start, start + 5):
            self.assertTrue(lines[index].startswith(b"> "))
            lines[index] = b"* " + lines[index].removeprefix(b"> ")
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: reclassify divergence quote as a star list",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "undispositioned governed citation"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_blockquote_evidence_moved_between_divergences(self) -> None:
        path = "docs/upstream.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        source = next(
            index
            for index, line in enumerate(lines)
            if line.startswith(
                b"> **Upstream**: ENSv2 reverse registration explicitly uses"
            )
        )
        evidence = lines.pop(source)
        destination = next(
            index
            for index, line in enumerate(lines)
            if line.startswith(b"> **ENS Universal Resolver proxy entrypoint")
        )
        lines.insert(destination + 1, evidence)
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: move evidence into another divergence",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "undispositioned governed citation"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_fenced_code_enclosure(self) -> None:
        path = "docs/architecture.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        site = 480
        self.assertTrue(lines[site].startswith(b"- `RegistryCreated()`"))
        lines[site:site] = [b"```text", b""]
        lines[site + 3 : site + 3] = [b"", b"```"]
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: enclose cited claim in a Markdown fence",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_does_not_close_fence_with_info_text(self) -> None:
        path = "docs/architecture.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        site = 480
        self.assertTrue(lines[site].startswith(b"- `RegistryCreated()`"))
        claim = lines.pop(site)
        lines.extend(
            [b"", b"```text", b"```not-a-closing-fence", b"## Discovery graph", claim]
        )
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: move cited claim after a non-closing fence line",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_does_not_close_raw_html_with_spaced_end_tag(self) -> None:
        path = "docs/architecture.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        site = 480
        self.assertTrue(lines[site].startswith(b"- `RegistryCreated()`"))
        claim = lines.pop(site)
        lines.extend(
            [b"", b"<script>", b"</script >", b"## Discovery graph", claim]
        )
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),
            "fixture: keep raw HTML open across a spaced end tag",
        )
        with self.assertRaisesRegex(
            rotation.RotationError, "final claim-context binding mismatch"
        ):
            self.verify_head(fixture)

    def test_verify_rejects_html_comment_enclosure(self) -> None:
        path = "docs/architecture.md"
        lines = git_bytes("show", f"{self.head}:{path}").split(b"\n")
        site = 480
        self.assertTrue(lines[site].startswith(b"- `RegistryCreated()`"))
        lines[site:site] = [b"<!--", b""]
        lines[site + 3 : site + 3] = [b"", b"-->"]
        fixture = commit_blob(
            self.head,
            path,
            b"\n".join(lines),

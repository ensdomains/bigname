#!/usr/bin/env python3
"""Require declared startup adapter version bumps for mapped source changes."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path


VERSION_FILE = Path("crates/adapters/src/startup_versions.rs")
VERSION_RE = re.compile(
    r"const ([A-Z0-9_]+)_DECLARATION:\s*i64\s*=\s*(\d+)\s*;",
)

# Family-owned production paths are intentionally conservative. Shared files
# list every startup family whose semantics they can affect. Test-only changes
# do not require a production compatibility bump.
FAMILY_PATHS: dict[str, tuple[str, ...]] = {
    "ENS_V1_REVERSE_CLAIM_STARTUP_VERSION": (
        "crates/adapters/src/ens_v1_reverse_claim.rs",
        "crates/adapters/src/ens_v1_reverse_claim/",
    ),
    "ENS_V1_SUBREGISTRY_DISCOVERY_STARTUP_VERSION": (
        "crates/adapters/src/ens_v1_subregistry_discovery.rs",
        "crates/adapters/src/ens_v1_subregistry_discovery/",
        "crates/manifests/src/lib/discovery/reconciliation/",
    ),
    "ENS_V1_UNWRAPPED_AUTHORITY_STARTUP_VERSION": (
        "crates/adapters/src/ens_v1_unwrapped_authority.rs",
        "crates/adapters/src/ens_v1_unwrapped_authority/",
    ),
    "ENS_V2_REGISTRY_RESOURCE_SURFACE_STARTUP_VERSION": (
        "crates/adapters/src/ens_v2_registry.rs",
        "crates/adapters/src/ens_v2_registry/",
        "crates/manifests/src/lib/discovery/reconciliation/",
    ),
    "ENS_V2_REGISTRAR_STARTUP_VERSION": (
        "crates/adapters/src/ens_v2_registrar.rs",
        "crates/adapters/src/ens_v2_registrar/",
    ),
    "ENS_V2_RESOLVER_STARTUP_VERSION": (
        "crates/adapters/src/ens_v2_resolver.rs",
        "crates/adapters/src/ens_v2_resolver/",
    ),
    "ENS_V2_PERMISSIONS_STARTUP_VERSION": (
        "crates/adapters/src/ens_v2_permissions.rs",
        "crates/adapters/src/ens_v2_permissions/",
    ),
}

ALL_FAMILIES = tuple(FAMILY_PATHS)
PRODUCER_PATHS: dict[str, tuple[str, ...]] = {
    "BLOCK_DERIVED_NORMALIZED_EVENTS_STARTUP_VERSION": (
        "crates/adapters/src/block_derived_normalized_events.rs",
        "crates/adapters/src/block_derived_normalized_events/",
        "apps/indexer/src/main/reconciliation/replay/classification/contracts.rs",
        "apps/indexer/src/main/reconciliation/adapter_sync/stateless.rs",
    ),
}

SHARED_PATHS: dict[str, tuple[str, ...]] = {
    "crates/adapters/src/registry_migration_cache.rs": (
        "ENS_V1_SUBREGISTRY_DISCOVERY_STARTUP_VERSION",
        "ENS_V1_UNWRAPPED_AUTHORITY_STARTUP_VERSION",
    ),
    "crates/adapters/src/ens_v2_common.rs": (
        "ENS_V2_REGISTRY_RESOURCE_SURFACE_STARTUP_VERSION",
        "ENS_V2_REGISTRAR_STARTUP_VERSION",
        "ENS_V2_RESOLVER_STARTUP_VERSION",
        "ENS_V2_PERMISSIONS_STARTUP_VERSION",
    ),
    "crates/adapters/src/ens_v2_common/": (
        "ENS_V2_REGISTRY_RESOURCE_SURFACE_STARTUP_VERSION",
        "ENS_V2_REGISTRAR_STARTUP_VERSION",
        "ENS_V2_RESOLVER_STARTUP_VERSION",
        "ENS_V2_PERMISSIONS_STARTUP_VERSION",
    ),
    "crates/adapters/src/evm_abi.rs": ALL_FAMILIES,
    "crates/adapters/src/adapter_manifest.rs": ALL_FAMILIES,
    "crates/adapters/src/normalized_event_support.rs": ALL_FAMILIES,
    "crates/adapters/src/checkpoint_codec.rs": (
        "ENS_V1_SUBREGISTRY_DISCOVERY_STARTUP_VERSION",
        "ENS_V1_UNWRAPPED_AUTHORITY_STARTUP_VERSION",
    ),
    "crates/adapters/src/checkpoint_context.rs": ALL_FAMILIES,
    "crates/adapters/src/manifest_normalized_events.rs": ALL_FAMILIES,
    "crates/adapters/src/block_derived_normalized_events.rs": ALL_FAMILIES,
    "crates/manifests/src/lib/views/watched.rs": ALL_FAMILIES,
    "crates/manifests/src/lib/views/watched/": ALL_FAMILIES,
    "crates/storage/src/startup_adapter_sync.rs": ALL_FAMILIES,
    "crates/storage/src/startup_adapter_sync/": ALL_FAMILIES,
    "crates/storage/src/raw_staging_revision.rs": ALL_FAMILIES,
    "crates/storage/src/raw_staging_revision/": ALL_FAMILIES,
    "apps/indexer/src/main/runtime/adapter_sync.rs": ALL_FAMILIES,
    "apps/indexer/src/main/runtime/adapter_sync/": ALL_FAMILIES,
}


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args],
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return result.stdout


def versions(text: str) -> dict[str, int]:
    return {name: int(value) for name, value in VERSION_RE.findall(text)}


def production_path(path: str) -> bool:
    return path.endswith(".rs") and not (
        path.endswith("/tests.rs")
        or "/tests/" in path
        or path.endswith("_tests.rs")
    )


def path_matches(path: str, mapped_path: str) -> bool:
    return path == mapped_path or path.startswith(mapped_path)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--base-ref", default="HEAD^")
    args = parser.parse_args()

    try:
        git("cat-file", "-e", f"{args.base_ref}^{{commit}}")
    except subprocess.CalledProcessError:
        print(
            f"Startup adapter semantic version check failed: base ref "
            f"{args.base_ref!r} is unavailable.",
            file=sys.stderr,
        )
        return 1

    try:
        base_text = git("show", f"{args.base_ref}:{VERSION_FILE}")
    except subprocess.CalledProcessError:
        print(
            "Startup adapter version check bootstrap: "
            f"{VERSION_FILE} is absent at {args.base_ref}."
        )
        return 0

    current_text = VERSION_FILE.read_text()
    base_versions = versions(base_text)
    current_versions = versions(current_text)
    changed_paths = {
        path
        for path in git("diff", "--name-only", args.base_ref, "--").splitlines()
        if production_path(path)
    }

    mapped_paths = FAMILY_PATHS | PRODUCER_PATHS
    affected: dict[str, set[str]] = {name: set() for name in mapped_paths}
    for name, prefixes in mapped_paths.items():
        for path in changed_paths:
            if any(path_matches(path, prefix) for prefix in prefixes):
                affected[name].add(path)
    for mapped_path, names in SHARED_PATHS.items():
        for path in changed_paths:
            if not path_matches(path, mapped_path):
                continue
            for name in names:
                affected[name].add(path)

    errors: list[str] = []
    for name, paths in affected.items():
        if not paths:
            continue
        before = base_versions.get(name)
        after = current_versions.get(name)
        if before is None or after is None:
            errors.append(f"{name}: declaration is missing in base or current source")
        elif after <= before:
            errors.append(
                f"{name}: version must increase above {before}, but is {after}, despite changes in "
                + ", ".join(sorted(paths))
            )

    if errors:
        print(
            "Startup adapter semantic version check failed. Increment every affected "
            f"declaration in {VERSION_FILE}:",
            file=sys.stderr,
        )
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 1

    print("Startup adapter semantic version check OK.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'USAGE'
Usage: scripts/release-smoke [--no-network]

Runs the local release smoke gate:
  - no-network sanity, when requested
  - local pinned upstream refs
  - prebuilt local API binary
  - local API /healthz contract (ready with live loops, honestly degraded without them)
  - public-edge allowlist through an ephemeral Caddy container

Environment:
  BIGNAME_DATABASE_URL or DATABASE_URL      PostgreSQL connection URL.
  BIGNAME_SMOKE_API_BIND_ADDR              API bind addr, default 127.0.0.1:3000.
  BIGNAME_SMOKE_API_HEALTH_URL             Health URL, default derived from bind addr.
  BIGNAME_SMOKE_INTERNAL_API_URL           API origin for edge checks, default derived from bind addr.
  BIGNAME_SMOKE_PUBLIC_EDGE_URL            Scratch Caddy URL, default http://127.0.0.1:3001.
  BIGNAME_SMOKE_CADDY_IMAGE                Caddy image, default caddy:2-alpine.
  BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS
                                            Internal edge-check timeout, default 60.
USAGE
}

log() {
  printf '[release-smoke] %s\n' "$*"
}

fail() {
  printf '[release-smoke] ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

no_network=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-network)
      no_network=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown argument: $1"
      ;;
  esac
  shift
done

BIGNAME_DATABASE_URL_OVERRIDE="${BIGNAME_DATABASE_URL-}"
DATABASE_URL_OVERRIDE="${DATABASE_URL-}"
BIGNAME_SMOKE_API_BIND_ADDR_OVERRIDE="${BIGNAME_SMOKE_API_BIND_ADDR-}"
BIGNAME_SMOKE_API_HEALTH_URL_OVERRIDE="${BIGNAME_SMOKE_API_HEALTH_URL-}"
BIGNAME_SMOKE_INTERNAL_API_URL_OVERRIDE="${BIGNAME_SMOKE_INTERNAL_API_URL-}"
BIGNAME_SMOKE_PUBLIC_EDGE_URL_OVERRIDE="${BIGNAME_SMOKE_PUBLIC_EDGE_URL-}"
BIGNAME_SMOKE_CADDY_IMAGE_OVERRIDE="${BIGNAME_SMOKE_CADDY_IMAGE-}"
BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS_OVERRIDE="${BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS-}"
BIGNAME_DATABASE_URL_WAS_SET="${BIGNAME_DATABASE_URL+x}"
DATABASE_URL_WAS_SET="${DATABASE_URL+x}"
BIGNAME_SMOKE_API_BIND_ADDR_WAS_SET="${BIGNAME_SMOKE_API_BIND_ADDR+x}"
BIGNAME_SMOKE_API_HEALTH_URL_WAS_SET="${BIGNAME_SMOKE_API_HEALTH_URL+x}"
BIGNAME_SMOKE_INTERNAL_API_URL_WAS_SET="${BIGNAME_SMOKE_INTERNAL_API_URL+x}"
BIGNAME_SMOKE_PUBLIC_EDGE_URL_WAS_SET="${BIGNAME_SMOKE_PUBLIC_EDGE_URL+x}"
BIGNAME_SMOKE_CADDY_IMAGE_WAS_SET="${BIGNAME_SMOKE_CADDY_IMAGE+x}"
BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS_WAS_SET="${BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS+x}"

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
if [ -n "$BIGNAME_DATABASE_URL_WAS_SET" ]; then
  export BIGNAME_DATABASE_URL="$BIGNAME_DATABASE_URL_OVERRIDE"
fi
if [ -n "$DATABASE_URL_WAS_SET" ]; then
  export DATABASE_URL="$DATABASE_URL_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_API_BIND_ADDR_WAS_SET" ]; then
  export BIGNAME_SMOKE_API_BIND_ADDR="$BIGNAME_SMOKE_API_BIND_ADDR_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_API_HEALTH_URL_WAS_SET" ]; then
  export BIGNAME_SMOKE_API_HEALTH_URL="$BIGNAME_SMOKE_API_HEALTH_URL_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_INTERNAL_API_URL_WAS_SET" ]; then
  export BIGNAME_SMOKE_INTERNAL_API_URL="$BIGNAME_SMOKE_INTERNAL_API_URL_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_PUBLIC_EDGE_URL_WAS_SET" ]; then
  export BIGNAME_SMOKE_PUBLIC_EDGE_URL="$BIGNAME_SMOKE_PUBLIC_EDGE_URL_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_CADDY_IMAGE_WAS_SET" ]; then
  export BIGNAME_SMOKE_CADDY_IMAGE="$BIGNAME_SMOKE_CADDY_IMAGE_OVERRIDE"
fi
if [ -n "$BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS_WAS_SET" ]; then
  export BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS="$BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS_OVERRIDE"
fi

export BIGNAME_DATABASE_URL="${BIGNAME_DATABASE_URL:-${DATABASE_URL:-postgres://bigname:bigname@127.0.0.1:5432/bigname}}"
BIGNAME_SMOKE_API_BIND_ADDR="${BIGNAME_SMOKE_API_BIND_ADDR:-127.0.0.1:3000}"
BIGNAME_SMOKE_API_HEALTH_URL="${BIGNAME_SMOKE_API_HEALTH_URL:-http://${BIGNAME_SMOKE_API_BIND_ADDR}/healthz}"
BIGNAME_SMOKE_INTERNAL_API_URL="${BIGNAME_SMOKE_INTERNAL_API_URL:-http://${BIGNAME_SMOKE_API_BIND_ADDR}}"
BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS="${BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS:-60}"

cargo_args=(--locked)
if [ "$no_network" -eq 1 ]; then
  export CARGO_NET_OFFLINE=true
  cargo_args+=(--offline)
fi

assert_no_network_mode() {
  [ "$no_network" -eq 1 ] || return 0

  case "$BIGNAME_SMOKE_API_BIND_ADDR" in
    127.*:*|localhost:*|"[::1]:"*) ;;
    *)
      fail "--no-network requires BIGNAME_SMOKE_API_BIND_ADDR to be loopback, got ${BIGNAME_SMOKE_API_BIND_ADDR}"
      ;;
  esac

  case "$BIGNAME_SMOKE_API_HEALTH_URL" in
    http://127.*|http://localhost:*|http://"[::1]":*) ;;
    *)
      fail "--no-network requires BIGNAME_SMOKE_API_HEALTH_URL to be loopback, got ${BIGNAME_SMOKE_API_HEALTH_URL}"
      ;;
  esac

  log "no-network mode enabled: cargo is offline and API health uses loopback only"
}

api_pid=""
health_http_status=""
target_dir="${CARGO_TARGET_DIR:-target}"
if [ -n "${CARGO_BUILD_TARGET:-}" ]; then
  api_bin="${target_dir}/${CARGO_BUILD_TARGET}/debug/bigname-api"
else
  api_bin="${target_dir}/debug/bigname-api"
fi
health_body_tmp="$(mktemp -t bigname-release-health.XXXXXX)"
api_log_tmp="$(mktemp -t bigname-release-api.XXXXXX.log)"

cleanup() {
  if [ -n "$api_pid" ] && kill -0 "$api_pid" 2>/dev/null; then
    kill "$api_pid" 2>/dev/null || true
    wait "$api_pid" 2>/dev/null || true
  fi
  rm -f "$health_body_tmp" "$api_log_tmp"
}
trap cleanup EXIT INT TERM

run_pinned_refs_check() {
  log "checking local pinned upstream refs"
  scripts/sync-refs --check
}

build_api_for_readiness() {
  log "building API binary for health probe"
  cargo build "${cargo_args[@]}" -p bigname-api --bin bigname-api
  [ -x "$api_bin" ] || fail "expected built API binary at ${api_bin}"
}

run_readiness_check() {
  require_command curl

  log "starting API for health probe on ${BIGNAME_SMOKE_API_BIND_ADDR}"
  "$api_bin" serve \
    --bind-addr "$BIGNAME_SMOKE_API_BIND_ADDR" \
    --metrics-bind-addr 127.0.0.1:0 \
    > "$api_log_tmp" 2>&1 &
  api_pid=$!

  for _attempt in $(seq 1 30); do
    if ! kill -0 "$api_pid" 2>/dev/null; then
      sed -n '1,160p' "$api_log_tmp" >&2 || true
      fail "API exited before health probe completed"
    fi

    http_status="$(
      curl --silent --show-error --max-time 2 \
        --output "$health_body_tmp" \
        --write-out '%{http_code}' \
        "$BIGNAME_SMOKE_API_HEALTH_URL" 2>/dev/null || true
    )"

    if [ "$http_status" = "200" ] && grep -q '"status":"ready"' "$health_body_tmp"; then
      health_http_status="$http_status"
      log "full readiness probe passed"
      return 0
    fi

    # A standalone smoke database has no phase runner. not_started is expected
    # when the phase schema exists; unavailable is expected before it.
    # A stale status proves a heartbeat row exists and must fail instead of
    # masking a wedged loop.
    if [ "$http_status" = "200" ] \
      && grep -q '"status":"degraded"' "$health_body_tmp" \
      && grep -q '"api_status":"ready"' "$health_body_tmp" \
      && grep -q '"process":{"status":"running"}' "$health_body_tmp" \
      && grep -q '"database":{"status":"reachable","reachable":true' "$health_body_tmp" \
      && grep -Eq '"phase_runner":{"status":"(not_started|unavailable)"' "$health_body_tmp"; then
      health_http_status="$http_status"
      log "standalone health contract passed; absent phase state is explicit"
      return 0
    fi

    sleep 1
  done

  sed -n '1,160p' "$api_log_tmp" >&2 || true
  sed -n '1,80p' "$health_body_tmp" >&2 || true
  fail "API health probe failed at ${BIGNAME_SMOKE_API_HEALTH_URL}"
}

run_public_edge_check() {
  local edge_args
  edge_args=(--start-caddy)
  if [ "$no_network" -eq 1 ]; then
    edge_args+=(--no-network)
  fi

  log "checking the public-edge allowlist through Caddy"
  BIGNAME_SMOKE_INTERNAL_API_URL="$BIGNAME_SMOKE_INTERNAL_API_URL" \
    BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS="$BIGNAME_SMOKE_INTERNAL_REQUEST_TIMEOUT_SECS" \
    BIGNAME_SMOKE_EXPECTED_HEALTH_STATUS="$health_http_status" \
    scripts/public-edge-smoke "${edge_args[@]}"
}

require_command cargo
require_command grep
require_command seq
assert_no_network_mode
run_pinned_refs_check
build_api_for_readiness
run_readiness_check
run_public_edge_check
log "release smoke gate passed"

#!/usr/bin/env bash
# Static checks for the documentation site in site/. The site has no build
# step, so these guard the properties a build would otherwise enforce: every
# request goes to the API the network switcher selects, no server-side
# placeholder or retired hostname is left, and the reference still carries
# the route entries the API crate's site_pages tests read.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

failures=0
fail() {
  printf '[check-site] ERROR: %s\n' "$*" >&2
  failures=$((failures + 1))
}

pages=(site/index.html site/docs/index.html)

for file in "${pages[@]}" site/network.js site/README.md; do
  [ -f "$file" ] || fail "missing $file"
done
[ "$failures" -eq 0 ] || exit 1

# The legacy host is gone; the example ENS name taytems.eth is fine.
if grep -rn 'taytems\.xyz' site; then
  fail "site/ names the retired taytems.xyz host"
fi

# The API used to substitute these when it served the pages; nothing does now.
if grep -rn '__BIGNAME_' site; then
  fail "site/ still carries a __BIGNAME_ server-side placeholder"
fi

# The site is hosted apart from the API, so nothing may talk to its own origin.
if grep -rn 'location\.origin' site; then
  fail "site/ uses location.origin; go through BignameNetwork.apiBase()"
fi
if grep -rnE "fetch\(\s*['\"\`]/" site; then
  fail "site/ fetches a same-origin path; go through BignameNetwork.apiBase()"
fi
# Every fetch in the pages goes through the switcher's base; network.js's own
# status fetch uses the base it just read.
if grep -rnE 'fetch\(' "${pages[@]}" | grep -vE 'fetch\(NET\.apiBase\(\) \+ '; then
  fail "a page fetch does not start from NET.apiBase()"
fi
if grep -nE 'fetch\(' site/network.js | grep -vE "fetch\(base \+ '/v1/status'"; then
  fail "a network.js fetch does not start from the selected base"
fi

for page in "${pages[@]}"; do
  grep -qE '<script src="(\.\./)?network\.js"></script>' "$page" \
    || fail "$page does not load network.js"
  grep -q 'NET.mount(' "$page" || fail "$page does not render the network switcher"
done

# apps/api/src/tests/site_pages.rs reads these entries to hold the router and
# the reference together; an empty set would make that test vacuous.
route_entries="$(grep -c "path: '/v1/" site/docs/index.html || true)"
if [ "$route_entries" -lt 1 ]; then
  fail "site/docs/index.html has no path: '/v1/...' route entries"
fi

if [ "$failures" -ne 0 ]; then
  exit 1
fi
printf '[check-site] ok: %s route entries, every request through the network switcher\n' "$route_entries"

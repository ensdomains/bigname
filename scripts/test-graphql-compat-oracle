 stale_census=temp/"stale-census"; shutil.copytree(first,stale_census); coverage=json.loads((stale_census/"coverage.json").read_text()); coverage["known_upstream_types"]["Ghost"]={"owner":"#1","docs":"x"}; (stale_census/"coverage.json").write_text(json.dumps(coverage,sort_keys=True,separators=(",",":"))+"\n"); resign(stale_census,"coverage.json"); verify(stale_census,False)
 duplicate=temp/"duplicate"; shutil.copytree(first,duplicate); manifest=json.loads((duplicate/"manifest.json").read_text()); manifest["cases"].append(manifest["cases"][0]); (duplicate/"manifest.json").write_text(json.dumps(manifest,sort_keys=True,separators=(",",":"))+"\n"); verify(duplicate,False)
 aliased=temp/"aliased"; shutil.copytree(first,aliased); manifest=json.loads((aliased/"manifest.json").read_text()); manifest["cases"][0].update({key:manifest["cases"][1][key] for key in ("entity","kind","query","variables","response")}); (aliased/"manifest.json").write_text(json.dumps(manifest,sort_keys=True,separators=(",",":"))+"\n"); verify(aliased,False)
 wrong_case_block=temp/"case-block"; shutil.copytree(first,wrong_case_block); variables=json.loads((wrong_case_block/"entities/domain/entity-by-id/variables.json").read_text()); variables["block"]["number"]=999; (wrong_case_block/"entities/domain/entity-by-id/variables.json").write_text(json.dumps(variables,sort_keys=True,separators=(",",":"))+"\n"); resign(wrong_case_block,"entities/domain/entity-by-id/variables.json"); verify(wrong_case_block,False)
 version=temp/"version"; shutil.copytree(first,version); manifest=json.loads((version/"manifest.json").read_text()); manifest["fixture_format_version"]=999; (version/"manifest.json").write_text(json.dumps(manifest,sort_keys=True,separators=(",",":"))+"\n"); result=verify(version,False); assert "upgrade" in result.stderr
 sys.dont_write_bytecode=True; loader=importlib.machinery.SourceFileLoader("oracle",str(tool)); spec=importlib.util.spec_from_loader("oracle",loader); module=importlib.util.module_from_spec(spec); loader.exec_module(module)
 membership={"types":[obj("Query",[]),{"kind":"INTERFACE","name":"DomainEvent","fields":[],"inputFields":None,"enumValues":None,"possibleTypes":[{"name":"Transfer"}],"interfaces":[]},{**obj("Transfer",[]),"interfaces":[{"name":"DomainEvent"}]}],"queryType":{"name":"Query"},"mutationType":None,"subscriptionType":None,"directives":[]}; surface=module.schema_surface(membership); assert surface["root:query"]=={"type":"Query"} and "implements:Transfer.DomainEvent" in surface and "member:DomainEvent.Transfer" in surface; assert b"type Transfer implements DomainEvent" in module.render_sdl(membership)
 import socket; original=socket.socket; socket.socket=lambda *_args,**_kwargs: (_ for _ in ()).throw(AssertionError("offline verifier opened a socket"))
 try:
  os.environ["BIGNAME_ALLOW_PROVISIONAL_GRAPHQL_ORACLE"]="1"; module.verify(first)

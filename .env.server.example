# Image published from this repository.
BIGNAME_IMAGE=ghcr.io/ensdomains/bigname:latest

# PostgreSQL service settings for docker-compose.server.yml.
POSTGRES_DB=bigname
POSTGRES_USER=bigname
POSTGRES_PASSWORD=change-me
BIGNAME_DATABASE_URL=postgresql://bigname:change-me@postgres:5432/bigname
# Per-service primary pool ceiling. The API reserves one additional readiness
# connection.
BIGNAME_DATABASE_MAX_CONNECTIONS=10
# Stable process identities shared by each service and its healthcheck command.
BIGNAME_WORKER_HEARTBEAT_INSTANCE_ID=worker

# API binding. The container listens on 3000; these control the host binding.
# Keep the API's host-published port private; Caddy is the public path.
BIGNAME_API_HOST=127.0.0.1
BIGNAME_API_PORT=3000
BIGNAME_API_BIND_ADDR=0.0.0.0:3000
BIGNAME_API_HEARTBEAT_MAX_AGE_SECS=20
BIGNAME_API_INDEXER_CHAIN_HEARTBEAT_MAX_AGE_SECS=14400
BIGNAME_API_WORKER_REBUILD_PHASE_MAX_AGE_SECS=43200
BIGNAME_API_STATUS_PROVIDER_TIMEOUT_MS=750
BIGNAME_API_STATUS_PROVIDER_REFRESH_SECS=5
BIGNAME_API_STATUS_PROVIDER_CACHE_TTL_SECS=30
BIGNAME_API_STATUS_MAX_BLOCK_LAG=30
BIGNAME_API_STATUS_MAX_LAG_SECS=60
# Maximum addresses accepted by the native identity batch endpoint.
BIGNAME_API_IDENTITY_BATCH_LIMIT=1000
# Maximum inputs accepted by the v2 lookup endpoint.
BIGNAME_API_LOOKUP_BATCH_LIMIT=1000
# Public-undrain starting values for API admission and execution bounds.
BIGNAME_API_REQUEST_TIMEOUT_MS=30000
BIGNAME_API_DB_STATEMENT_TIMEOUT_MS=25000
BIGNAME_API_MAX_IN_FLIGHT=256
BIGNAME_API_HEALTH_MAX_IN_FLIGHT=4
BIGNAME_API_VERIFIED_EXECUTION_MAX_IN_FLIGHT=16
BIGNAME_API_RPC_CONNECT_TIMEOUT_MS=2000
BIGNAME_API_RPC_TIMEOUT_MS=8000
BIGNAME_API_VERIFIED_RATE_LIMIT_PER_SECOND=1
BIGNAME_API_VERIFIED_RATE_LIMIT_BURST=5
BIGNAME_API_VERIFIED_RATE_LIMIT_MAX_CLIENTS=65536
BIGNAME_API_TRUST_X_FORWARDED_FOR=true

# Public reverse proxy for docker-compose.public.yml. Use a hostname for
# automatic HTTPS after DNS points at the server, or :80 for HTTP-only bring-up.
BIGNAME_PUBLIC_SITE_ADDRESS=:80
BIGNAME_PUBLIC_HTTP_PORT=80
BIGNAME_PUBLIC_HTTPS_PORT=443

# Comma-delimited <chain>=<url> entries for API-triggered live execution and
# status readiness. Every expected status chain must be present in production.
# ENS verified resolution currently needs ethereum-mainnet when no matching
# persisted execution output exists.
# API JSON-RPC support accepts http:// and https:// endpoints.
# BIGNAME_API_CHAIN_RPC_URLS=ethereum-mainnet=http://host.docker.internal:8545

# The Stage B image includes the ingest/interpret phase runner, but
# docker-compose.server.yml intentionally does not launch it until project/live
# land. These values are useful for explicit phase verification.
BIGNAME_PHASE_RUNNER_MANIFESTS_ROOT=/app/manifests/mainnet
# BIGNAME_PHASE_RUNNER_CHAINS=ethereum-mainnet
# BIGNAME_PHASE_RUNNER_SOURCES=ethereum-mainnet:rpc:json_rpc:ethereum_head:0=ETHEREUM_RPC_URL
# ETHEREUM_RPC_URL=http://host.docker.internal:8545

BIGNAME_WORKER_POLL_INTERVAL_SECS=5
BIGNAME_WORKER_HEARTBEAT_MAX_AGE_SECS=20
BIGNAME_WORKER_REBUILD_PHASE_MAX_AGE_SECS=43200
BIGNAME_WORKER_PRIMARY_NAME_ROUTE_CACHE_RETENTION_CHECKPOINTS=50000
BIGNAME_WORKER_PRIMARY_NAME_ROUTE_CACHE_PRUNE_BATCH_SIZE=5000

# Optional worker RPC for projection-owned ENSv1 legacy text hydration and
# legacy event-silent reverse resolver primary-name hydration.
# May mirror BIGNAME_API_CHAIN_RPC_URLS when that provider can serve hash-pinned
# archive eth_call requests at the stored checkpoint.
# BIGNAME_WORKER_CHAIN_RPC_URLS=ethereum-mainnet=http://host.docker.internal:8545
BIGNAME_WORKER_TEXT_HYDRATION_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
BIGNAME_WORKER_TEXT_HYDRATION_BATCH_SIZE=250
# Optional comma-delimited extra legacy reverse resolver addresses. Use the
# same address list used when the corresponding raw observations were indexed.
# BIGNAME_WORKER_PRIMARY_NAME_LEGACY_REVERSE_RESOLVER_ADDRESSES=0x...
BIGNAME_WORKER_PRIMARY_NAME_LEGACY_REVERSE_HYDRATION_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
BIGNAME_WORKER_PRIMARY_NAME_LEGACY_REVERSE_HYDRATION_BATCH_SIZE=250

RUST_LOG=info,sqlx::query=error
# Emit JSON logs when this variable is present; compose does not pass it by default.
# BIGNAME_LOG_JSON=1

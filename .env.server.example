# Image published from this repository.
BIGNAME_IMAGE=ghcr.io/ensdomains/bigname:latest

# PostgreSQL service settings for docker-compose.server.yml.
POSTGRES_DB=bigname
POSTGRES_USER=bigname
# Required: the server compose file refuses to start without it.
POSTGRES_PASSWORD=change-me
# Explicit connection ceiling. Size it from docs/deployment.md § Database
# connection budget: every service peak, plus a concurrent redo or rewind, plus
# the superuser reservation below, plus headroom for psql and sqlx migrate.
# Then budget it against work_mem: a backend can hold several work_mem
# allocations at once, so max_connections x work_mem x a few is the worst case
# this server can commit to.
POSTGRES_MAX_CONNECTIONS=100
# Slots only superusers may use. The writer login is a superuser; bigname_api and
# bigname_verify are not, so they are refused once max_connections minus this
# value is reached. Counted in the ceiling above; do not set it to zero.
POSTGRES_SUPERUSER_RESERVED_CONNECTIONS=3
# Writer/owner credential for explicit phase runs and planned migrations.
# Required by the server compose file; there is no derived fallback. The
# password must be the same as POSTGRES_PASSWORD, percent-encoded if it contains
# URI-reserved characters (for example / ? # % @ :), because SQLx parses this as
# a URL while PostgreSQL is initialised with the literal value.
BIGNAME_DATABASE_URL=postgresql://bigname:change-me@postgres:5432/bigname
# Distinct non-owner login provisioned with the grants in docs/deployment.md.
# The server compose file refuses to start the API without this value.
BIGNAME_API_DATABASE_URL=postgresql://bigname_api:change-api-secret@postgres:5432/bigname
# API request-pool ceiling. Read by the API only; it reserves one additional
# readiness connection beyond this. The phase runner does NOT read it — it sizes
# its pools from the configured chain count. See docs/deployment.md
# § Database connection budget for both.
BIGNAME_DATABASE_MAX_CONNECTIONS=10

# API binding. The container listens on 3000; these control the host binding.
# Keep the API's host-published port private; Caddy is the public path.
BIGNAME_API_HOST=127.0.0.1
BIGNAME_API_PORT=3000
BIGNAME_API_BIND_ADDR=0.0.0.0:3000
BIGNAME_API_PHASE_HEARTBEAT_MAX_AGE_SECS=60
BIGNAME_API_STATUS_PROVIDER_TIMEOUT_MS=750
BIGNAME_API_STATUS_PROVIDER_REFRESH_SECS=5
BIGNAME_API_STATUS_PROVIDER_CACHE_TTL_SECS=30
BIGNAME_API_STATUS_MAX_BLOCK_LAG=30
BIGNAME_API_STATUS_MAX_LAG_SECS=60
# Maximum inputs accepted by the v2 lookup endpoint.
BIGNAME_API_LOOKUP_BATCH_LIMIT=1000
# Public-undrain starting values for API admission and execution bounds.
BIGNAME_API_REQUEST_TIMEOUT_MS=30000
# Stop grace must exceed the request timeout by at least 5000 ms.
BIGNAME_API_STOP_GRACE_MS=45000
BIGNAME_API_DB_STATEMENT_TIMEOUT_MS=25000
BIGNAME_API_MAX_IN_FLIGHT=256
BIGNAME_API_HEALTH_MAX_IN_FLIGHT=4
BIGNAME_API_VERIFIED_EXECUTION_MAX_IN_FLIGHT=16
BIGNAME_API_RPC_CONNECT_TIMEOUT_MS=2000
BIGNAME_API_RPC_TIMEOUT_MS=8000
BIGNAME_API_VERIFIED_RATE_LIMIT_PER_SECOND=1
BIGNAME_API_VERIFIED_RATE_LIMIT_BURST=5
BIGNAME_API_VERIFIED_RATE_LIMIT_MAX_CLIENTS=65536
BIGNAME_API_TRUST_X_FORWARDED_FOR=true

# Public reverse proxy for docker-compose.public.yml. Use a hostname for
# automatic HTTPS after DNS points at the server, or :80 for HTTP-only bring-up.
BIGNAME_PUBLIC_SITE_ADDRESS=:80
BIGNAME_PUBLIC_HTTP_PORT=80
BIGNAME_PUBLIC_HTTPS_PORT=443

# Comma-delimited <chain>=<url> entries for API-triggered live execution and
# status readiness. Every expected status chain must be present in production.
# ENS verified resolution and ENS/60 primary-name verification currently need
# ethereum-mainnet for request-scoped lookup.
# API JSON-RPC support accepts http:// and https:// endpoints.
# BIGNAME_API_CHAIN_RPC_URLS=ethereum-mainnet=http://host.docker.internal:8545

# Full ingest-through-live phase-runner configuration.
BIGNAME_PHASE_RUNNER_MANIFESTS_ROOT=/app/manifests/mainnet
# Required: choose a positive deployment-specific reserve in bytes; zero disables it.
# Missing/empty values fail Compose rendering. Complete the capacity preflight in
# docs/runbooks/production-docker.md before starting or recreating the runner.
BIGNAME_PHASE_RUNNER_MINIMUM_FREE_DISK_BYTES=
# Required absolute host/container path: pre-create a dedicated writable sibling
# on PostgreSQL's actual filesystem, outside its data tree and other mounts.
# Permissions must work for the effective runner user; never expose DB files.
BIGNAME_PHASE_RUNNER_WRITABLE_PATH=
# Optional logical database ceiling: omit when unused; empty is invalid, not unset.
# Supply an unsigned 64-bit decimal value only after reviewing storage headroom.
# BIGNAME_PHASE_RUNNER_DATABASE_MAX_BYTES=<operator-selected-bytes>
# Authenticate this SELECT-only login directly against the writer's same
# PostgreSQL cluster/database; do not assume it from a writer session.
BIGNAME_PHASE_RUNNER_VERIFICATION_DATABASE_URL=postgresql://bigname_verify:change-verify-secret@postgres:5432/bigname
BIGNAME_PHASE_RUNNER_CHAINS=ethereum-mainnet
BIGNAME_PHASE_RUNNER_SOURCES=ethereum-mainnet:reth:reth_db:ethereum_head:0=RETH_DATA_DIR
BIGNAME_PHASE_RUNNER_HYDRATION_RPC_URLS=ethereum-mainnet=http://host.docker.internal:8545
# The reth overlay mounts this host path read-only at the same container path
# and forwards it for the source descriptor above.
RETH_DATA_DIR=/var/lib/reth/mainnet
# Container stop grace period. A stop is honoured at the next phase batch
# boundary, so this has to outlast one batch. A batch is not one transaction:
# each phase commits its own writes before the runner records progress, so a
# SIGKILL can leave committed phase output ahead of the durable progress marker.
# A transaction still open when the signal lands does roll back; what does not
# roll back is the batch as a whole. The restart replays that range, which is
# idempotent. Keep it above 10s: a stop during start-up recovery is bounded by
# a fixed ten-second deadline in the runner, and a shorter grace period reaches
# SIGKILL before that deadline reports.
BIGNAME_PHASE_RUNNER_STOP_GRACE_PERIOD=120s

RUST_LOG=info,sqlx::query=error
# Emit JSON logs from both binaries. Compose forwards this; empty and the
# negative spellings (0, false, no, off) all mean plain compact logs.
# BIGNAME_LOG_JSON=1

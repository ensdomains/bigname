{
  "annotations": {
    "list": []
  },
  "description": "Indexing phase progress, liveness, verification, repair work, and chain-head lag.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The value 1 identifies each chain phase's current lifecycle state.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "showPoints": "never"
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_phase_status{job=\"bigname-phase-runner\"} == 1",
          "legendFormat": "{{chain}} / {{phase}} / {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Phase lifecycle state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Processed block and current target for each phase. A value of -1 means the database has no recorded position.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_phase_current_block{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}} current",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_phase_target_block{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}} target",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Phase progress",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Seconds since each phase last completed a heartbeat opportunity and since the runner loop for each configured chain last made progress. The configured paging threshold is plotted alongside the ages and must be set above the slowest expected batch; -1 means no phase heartbeat exists yet.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_heartbeat_age_seconds{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_heartbeat_stale_threshold_seconds{job=\"bigname-phase-runner\"}",
          "legendFormat": "configured stale threshold ({{threshold_seconds}}s)",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_loop_heartbeat_age_seconds{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / runner loop",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Heartbeat age",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Observed provider target minus each phase's processed block. Live pages when lag exceeds 30 and a running sample appears in every 2-minute window for 10 minutes, so brief batch-completion zeroes do not reset persistent lag while failed or resting phases do not sustain the alert.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_head_lag_blocks{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Head lag in blocks",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The value 1 identifies the strongest verification level recorded for each chain.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_verification_level{job=\"bigname-phase-runner\"} == 1",
          "legendFormat": "{{chain}} / {{level}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Verification level",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Shows unfinished repair work, its block position, and whether Interpret output was built with another interpreter content hash.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 26
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "phase_runner_redo_current_block{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}} repair current",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_redo_target_block{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}} repair target",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_reinterpretation_required{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} reinterpretation required",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_redo_in_progress{job=\"bigname-phase-runner\"}",
          "legendFormat": "{{chain}} / {{phase}} repair active",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Repair and reinterpretation state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Prometheus scrape health and whether the endpoint's latest PostgreSQL refresh succeeded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"bigname-phase-runner\"}",
          "legendFormat": "scrape",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "phase_runner_metrics_refresh_success{job=\"bigname-phase-runner\"}",
          "legendFormat": "database refresh",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Exporter health",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "bigname",
    "pipeline",
    "operations"
  ],
  "templating": {
    "list": [
      {
        "current": {},

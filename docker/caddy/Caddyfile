{
	admin {$BIGNAME_CADDY_ADMIN:localhost:2019}
}

{$BIGNAME_PUBLIC_SITE_ADDRESS} {
	{$BIGNAME_PUBLIC_BIND_DIRECTIVE}

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}

	@v1_reads {
		method GET HEAD
		path /v1/*
	}

	@v1_lookup {
		method POST
		path /v1/lookup
	}

	# The OpenAPI document is public and read-only, fetched cross-origin by the
	# documentation site. The API embeds the generated contract artifact.
	@openapi {
		method GET HEAD
		path /openapi.json
	}

	@preflight {
		method OPTIONS
		path /v1/lookup
	}

	route {
		reverse_proxy @v1_reads {$BIGNAME_PUBLIC_UPSTREAM}
		reverse_proxy @v1_lookup {$BIGNAME_PUBLIC_UPSTREAM}
		reverse_proxy @preflight {$BIGNAME_PUBLIC_UPSTREAM}
		# Deferred, so it replaces rather than duplicates a CORS header the API sets.
		header @openapi >Access-Control-Allow-Origin *
		reverse_proxy @openapi {$BIGNAME_PUBLIC_UPSTREAM}
		respond 404
	}
}

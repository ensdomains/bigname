shard_4_tests=(
    "harness::db::tests::concurrent_harness_databases_clone_the_migrated_template"
    "harness::db::tests::migration_template_identity_is_stable_and_identifier_sized"
    "harness::db::tests::replace_database_rejects_missing_database_path"
    "harness::fault_proxy::tests::ordered_one_shot_faults_advance_one_response_at_a_time"
    "harness::pipeline::tests::one_shot_command_deadline_terminates_descendants"
    "harness::tests::local_server_start_lock_serializes_waiters"
    "scenarios::basenames_lifecycle::legacy_reverse_registrar_stays_registry_and_raw_record_only"
    "scenarios::catchup_equivalence::primary_route_normalization_preserves_contract_instance_identity"
    "scenarios::cross_protocol::locked_parent_publishes_only_migratable_ens_v1_children"
    "scenarios::ens_v2_lifecycle::renewal_preserves_promoted_coverage_and_registry_edges_follow"
    "scenarios::lifecycle::expire_without_reregistration_releases_and_unlists_registration"
    "scenarios::perturbations::pre_surface_records_converge_fresh_incremental_and_restored"
    "scenarios::perturbations::rich_chain_rpc_ingest_normalized_events_match_upfront_facts"
    "scenarios::provider_faults::silently_short_logs_are_accepted_until_explicit_refetch_matches_control"
    "scenarios::register_eth_name::register_eth_name_end_to_end"
    "scenarios::registry_driven_reads::deep_registry_hierarchy_lists_direct_children_only"
    "scenarios::registry_preimages::label_preimage_revealed_later_upgrades_child_listing"
    "scenarios::resolver_records::pre_surface_newowner_record_serves_after_late_surface"
    "scenarios::resolver_records::pre_surface_record_attribution_is_node_scoped_and_never_materializes_unknown_names"
    "scenarios::reverse_primary::reverse_claim_invalid_name_surfaces_raw_claim"
    "scenarios::reverse_primary_claims::unadmitted_reverse_resolver_keeps_candidate_absent"
    "scenarios::wrapper::wrapper_wrap_fuses_subnames_and_unwrap_restore_identity"
    "scenarios::wrapper_registration::wrap_existing_registry_subname_rotates_child_only"
)
shard="${BIGNAME_E2E_SHARD:-all}"
case "$shard" in
    all | 1 | 2 | 3 | 4) ;;
    *)
        printf 'e2e gate: BIGNAME_E2E_SHARD must be 1 through 4 (or unset for all); got %q\n' \
            "$shard" >&2
        exit 64
        ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
real_cargo="${BIGNAME_E2E_REAL_CARGO:-$(command -v cargo)}"
bridge="$repo_root/tests/e2e/cargo-phase-runner-artifact"
if [ ! -x "$real_cargo" ]; then
    printf 'e2e gate: real Cargo is not executable: %s\n' "$real_cargo" >&2
    exit 66
fi
if [ -n "${BIGNAME_E2E_CANONICAL_PHASE_RUNNER:-}" ]; then
    export BIGNAME_E2E_REAL_CARGO="$real_cargo"
    export BIGNAME_E2E_CANONICAL_PHASE_RUNNER
    host_triple="$("$real_cargo" -vV | sed -n 's/^host: //p')"
    if [ -z "$host_triple" ]; then
        printf 'e2e gate: Cargo did not report its host target triple\n' >&2
        exit 1
    fi
    runner_env="CARGO_TARGET_${host_triple^^}_RUNNER"
    runner_env="${runner_env//-/_}"
    printf -v "$runner_env" '%s --run-test' "$bridge"
    export "$runner_env"
fi

gate_temp="$(mktemp -d "${TMPDIR:-/tmp}/bigname-e2e-gate.XXXXXX")"
result_log="$gate_temp/result.log"
profile_binary_parent="$repo_root/target/bigname-e2e-profile-binaries"
mkdir -p "$profile_binary_parent"
profile_binary_dir="$(mktemp -d "$profile_binary_parent/run.XXXXXX")"

cleanup() {
    rm -rf -- "$gate_temp" "$profile_binary_dir"
}
trap cleanup EXIT
export BIGNAME_E2E_PROFILE_BINARY_DIR="$profile_binary_dir"

discovered_raw="$gate_temp/discovered.raw"
ignored_raw="$gate_temp/ignored.raw"
discovered_names="$gate_temp/discovered.names"
ignored_names="$gate_temp/ignored.names"
expected_ignored_names="$gate_temp/expected-ignored.names"
all_assignments="$gate_temp/all-assignments.names"
union_names="$gate_temp/union.names"
selected_names="$gate_temp/selected.names"

cd "$repo_root"
compile_started="$(date +%s)"
if ! "$real_cargo" test --manifest-path tests/e2e/Cargo.toml --locked -- --list >"$discovered_raw"; then
    printf 'e2e gate: test discovery failed\n' >&2
    exit 1
fi
compile_finished="$(date +%s)"
if ! "$real_cargo" test --manifest-path tests/e2e/Cargo.toml --locked -- --ignored --list >"$ignored_raw"; then
    printf 'e2e gate: ignored-test discovery failed\n' >&2
    exit 1
fi
sed -n 's/: test$//p' "$discovered_raw" | LC_ALL=C sort >"$discovered_names"
sed -n 's/: test$//p' "$ignored_raw" | LC_ALL=C sort >"$ignored_names"
printf '%s\n' "${expected_ignored_tests[@]}" | LC_ALL=C sort >"$expected_ignored_names"
: >"$all_assignments"

count_lines() {
    wc -l <"$1" | tr -d ' '
}

identity_failed=0
for ((i = 1; i <= shard_count; i++)); do
    case "$i" in
        1) assignments=("${shard_1_tests[@]}"); expected_pass="$expected_shard_1_runnable"; expected_ignore="$expected_shard_1_ignored" ;;
        2) assignments=("${shard_2_tests[@]}"); expected_pass="$expected_shard_2_runnable"; expected_ignore="$expected_shard_2_ignored" ;;
        3) assignments=("${shard_3_tests[@]}"); expected_pass="$expected_shard_3_runnable"; expected_ignore="$expected_shard_3_ignored" ;;
        4) assignments=("${shard_4_tests[@]}"); expected_pass="$expected_shard_4_runnable"; expected_ignore="$expected_shard_4_ignored" ;;
    esac
    names="$gate_temp/shard-$i.names"
    printf '%s\n' "${assignments[@]}" | LC_ALL=C sort >"$names"
    cat "$names" >>"$all_assignments"
    selected_ignored="$(LC_ALL=C comm -12 "$names" "$ignored_names" | wc -l | tr -d ' ')"
    selected_runnable="$(($(count_lines "$names") - selected_ignored))"
    if [ "$selected_runnable" -ne "$expected_pass" ] || [ "$selected_ignored" -ne "$expected_ignore" ]; then
        printf 'e2e gate: shard %s inventory count mismatch\n' "$i" >&2
        identity_failed=1
    fi
    printf 'e2e shard %s assignment SHA-256: %s\n' "$i" "$(sha256sum "$names" | cut -d' ' -f1)"
done
LC_ALL=C sort "$all_assignments" -o "$all_assignments"
LC_ALL=C sort -u "$all_assignments" >"$union_names"
if [ -n "$(uniq -d "$all_assignments")" ]; then
    printf 'e2e gate: duplicate assignments within or across shards\n' >&2
    identity_failed=1
fi
if [ -n "$(uniq -d "$discovered_names")" ] || ! cmp -s "$discovered_names" "$union_names"; then
    printf 'e2e gate: discovered tests and complete shard assignments differ\n' >&2
    identity_failed=1
fi
if [ -n "$(uniq -d "$expected_ignored_names")" ] || ! cmp -s "$expected_ignored_names" "$ignored_names"; then
    printf 'e2e gate: ignored-test identities changed\n' >&2
    identity_failed=1
fi
discovered_total="$(count_lines "$discovered_names")"
ignored_total="$(count_lines "$ignored_names")"
runnable_total="$((discovered_total - ignored_total))"
if [ "$discovered_total" -ne "$expected_total" ] ||
   [ "$runnable_total" -ne "$expected_runnable" ] ||
   [ "$ignored_total" -ne "$expected_ignored" ]; then
    printf 'e2e gate: inventory count mismatch\n' >&2
    identity_failed=1
fi
if [ "$identity_failed" -ne 0 ]; then
    exit 1
fi

test_threads="${BIGNAME_E2E_TEST_THREADS:-8}"
test_args=(test --manifest-path tests/e2e/Cargo.toml --locked --)
expected_failed=0
if [ "$shard" = all ]; then
    expected_passed="$expected_runnable"
    expected_selected_ignored="$expected_ignored"
    expected_filtered=0
    cp "$discovered_names" "$selected_names"
else
    cp "$gate_temp/shard-$shard.names" "$selected_names"
    expected_selected_ignored="$(LC_ALL=C comm -12 "$selected_names" "$ignored_names" | wc -l | tr -d ' ')"
    expected_passed="$(($(count_lines "$selected_names") - expected_selected_ignored))"
    expected_filtered="$((expected_total - expected_passed - expected_selected_ignored))"
    test_args+=(--exact)
    while IFS= read -r name; do
        test_args+=(--skip "$name")
    done < <(LC_ALL=C comm -23 "$discovered_names" "$selected_names")
fi
test_args+=(--test-threads="$test_threads")

scenario_started="$(date +%s)"
"$real_cargo" "${test_args[@]}" 2>&1 | tee "$result_log"
cargo_status="${PIPESTATUS[0]}"
scenario_finished="$(date +%s)"

summary="$(grep -m1 '^test result:' "$result_log" || true)"
expected_prefix="test result: ok. ${expected_passed} passed; ${expected_failed} failed; ${expected_selected_ignored} ignored; 0 measured; ${expected_filtered} filtered out;"
if [ "$cargo_status" -ne 0 ]; then
    printf 'e2e gate: cargo test failed with status %s\n' "$cargo_status" >&2
    exit "$cargo_status"
fi
case "$summary" in
    "$expected_prefix"*) ;;
    *)
        printf 'e2e gate: unexpected suite summary\nexpected: %s\nactual:   %s\n' "$expected_prefix" "$summary" >&2
        exit 1
        ;;
esac

compile_seconds="$((compile_finished - compile_started))"
scenario_seconds="$((scenario_finished - scenario_started))"
summary_assignment_hash="$(sha256sum "$selected_names" | cut -d' ' -f1)"
printf 'e2e gate: shard %s; %s passed; %s failed; %s ignored; %s filtered\n' \
    "$shard" "$expected_passed" "$expected_failed" "$expected_selected_ignored" "$expected_filtered"
printf 'e2e gate timing: harness compile/discovery %ss; scenario execution %ss\n' "$compile_seconds" "$scenario_seconds"
if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    {
        printf '### e2e shard %s\n\n' "$shard"
        printf -- '- Harness compile/discovery: %ss\n' "$compile_seconds"
        printf -- '- Scenario execution: %ss\n' "$scenario_seconds"
        printf -- '- Summary: `%s`\n' "$summary"
        printf -- '- Discovered: %s (%s runnable, %s ignored)\n' "$discovered_total" "$runnable_total" "$ignored_total"
        printf -- '- Assignment SHA-256: `%s`\n' "$summary_assignment_hash"
    } >>"$GITHUB_STEP_SUMMARY"
fi

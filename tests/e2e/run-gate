    "scenarios::perturbations::rich_chain_projection_and_normalized_event_replay_are_route_stable"
    "scenarios::perturbations::rich_chain_rpc_ingest_normalized_events_match_upfront_facts"
    "scenarios::provider_faults::pruned_get_code_fails_closed_then_uses_configured_fallback"
    "scenarios::provider_faults::silently_short_logs_are_accepted_until_explicit_refetch_matches_control"
    "scenarios::provider_faults::transient_get_code_retries_primary_without_using_configured_fallback"
    "scenarios::provider_faults::transient_provider_faults_and_partial_receipts_recover_to_control"
    "scenarios::record_families::pubkey_write_on_admitted_resolver_stays_raw_only"
    "scenarios::registry_driven_reads::zero_owner_subname_leaves_default_children_listing"
    "scenarios::registry_migration::registry_migration_legacy_to_current_semantics"
    "scenarios::resolver_authorization::operator_delegate_writes_match_owner_authorship"
    "scenarios::resolver_records::pre_surface_newowner_record_serves_after_late_surface"
    "scenarios::resolver_records::pre_surface_record_history_follows_current_resolver_and_version_boundary"
    "scenarios::resolver_records::records_route_values_and_version_boundaries_follow_current_resolver"
    "scenarios::reverse_primary::generic_name_record_set_changed_then_cleared_stays_unadmitted"
    "scenarios::reverse_primary::reverse_claim_invalid_name_surfaces_raw_claim"

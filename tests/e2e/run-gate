    "harness::perturb::tests::normalized_event_parity_includes_transaction_index"
    "harness::pipeline::tests::stop_reports_a_child_that_crashes_between_status_check_and_kill"
    "harness::pipeline::tests::timeout_configuration_requires_positive_integer_seconds"
    "harness::responses::tests::pointer_preserves_explicit_null"
    "harness::responses::tests::pointer_rejects_missing_path"
    "scenarios::basenames_lifecycle::basenames_subnames_list_preimages_placeholders_and_tombstones"
    "scenarios::basenames_lifecycle::l2_zero_addr60_uses_stubbed_verified_transport"
    "scenarios::basenames_lifecycle::legacy_reverse_registrar_stays_registry_and_raw_record_only"
    "scenarios::basenames_lifecycle::upgradeable_controller_proxy_registers_and_renews"
    "scenarios::cross_protocol::composed_mainnet_profile_serves_both_protocols_without_leakage"
    "scenarios::ens_v2_lifecycle::renewal_preserves_promoted_coverage_and_registry_edges_follow"
    "scenarios::ens_v2_live_poll::ens_v2_registry_lifecycle_survives_successive_fixture_replays"
